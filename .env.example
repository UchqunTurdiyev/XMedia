# ===== SAYT =====
NEXT_PUBLIC_SITE_URL=https://xmedia.uz

# ===== META (Pixel + Conversions API) =====
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_ACCESS_TOKEN=EAAG...                 # Events Manager -> Settings -> Conversions API -> Generate access token
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=                     # Test paytida: TEST12345. Ishga tushganda BO'SH qoldiring!

# Sifatli lid uchun event nomi (Events Manager'da Custom Conversion qilib optimizatsiya qilasiz)
META_QUALIFIED_EVENT=QualifiedLead

# Purchase valyutasi va kurs. Operator summani so'mda yozadi -> USD ga aylantirib yuboriladi.
# Agar CAPI_CURRENCY=UZS qilsangiz, summa so'mda o'zgarishsiz yuboriladi.
CAPI_CURRENCY=USD
UZS_PER_USD=12700

# ===== TELEGRAM BOT =====
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=-1001234567890           # Lidlar tushadigan guruh ID (botni guruhga qo'shib /id yozing)
TELEGRAM_WEBHOOK_SECRET=uzun-tasodifiy-satr-123
TELEGRAM_ADMIN_IDS=                       # Ixtiyoriy: 11111,22222 — faqat shu userlar tugma bosa oladi. Bo'sh = guruhdagi hamma

# ===== UPSTASH REDIS (lidlarni saqlash) =====
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Webhook o'rnatish sahifasi himoyasi: /api/telegram/setup?key=...
SETUP_KEY=boshqa-uzun-satr-456
